# ── VideoDB ──────────────────────────────────────────────
VIDEO_DB_API_KEY=
VIDEO_DB_BASE_URL=https://api.videodb.io

# ── Anthropic (Claude Sonnet — explanation layer ONLY) ───
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_TIMEOUT_S=8

# ── Supabase (metadata / labels / eval results only) ─────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=                       # postgres connection string (pooled)

# ── Redis (Upstash, TLS) ─────────────────────────────────
REDIS_URL=                          # rediss://default:<pwd>@<host>:<port>
REDIS_IDEMPOTENCY_TTL_S=86400
REDIS_DEMO_CACHE_TTL_S=3600

# ── Webhooks / public ingress (ngrok during demo) ────────
WEBHOOK_BASE_URL=                   # e.g. https://<sub>.ngrok-free.app
PUBLIC_BASE_URL=http://localhost:8000

# ── App config ───────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
REPLAY_MODE=false
DEMO_TASK_NAME=demo_login_flow
CAPTURE_FRAME_INTERVAL_S=5          # 1 frame / 5s — cost trade-off (see README)

# ── Web (Next.js, NEXT_PUBLIC_* are browser-exposed) ─────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
